# Server-only (SSOT-03: src/config/env.server.ts)
JAVA_API_BASE_URL=http://localhost:8080
JAVA_API_TIMEOUT_MS=10000

# D1: when "enabled", MSW intercepts outbound calls to JAVA_API_BASE_URL in the
# Next server process. Set to "disabled" once the Java service is reachable.
API_MOCKING=enabled

# Client-safe (SSOT-03: src/config/env.client.ts). SEC-01: treat as published.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only, and OPTIONAL. Hosts allowed to load Next's /_next/* resources
# cross-origin, so the store can be opened from a phone on the same network.
# Next blocks these by default: without it the page renders but NO client
# JavaScript runs, so links work and search, the bag and checkout do not.
# Comma-separated bare hosts, no scheme or port. Leave unset on a machine that
# only ever serves localhost.
# DEV_ALLOWED_ORIGINS=192.168.1.50

# Architecture §24 Try-On, and OPTIONAL. Both configure the MOCK layer, which
# stands in for Java module 14 under D1 — the storefront never calls the
# provider itself, and neither value reaches the browser (SEC-01).
#
# The key is the ONLY thing standing between this checkout and a real
# generation: `imageModelProvider` in src/lib/mocks/try-on-provider.ts already
# posts the customer's photograph and the garment's to Google's
# generativelanguage endpoint. There is no other code to switch on.
#
# With no key set, TRY_ON_SAMPLE_RESULT below decides what happens, and its
# default is "enabled" — so a fresh checkout reports the feature AVAILABLE and
# answers with the labelled sample. The try-on button is drawn either way;
# ProductTryOn.tsx explains why it is never hidden.
#
# Generations are metered and billed by the provider, so treat the key as a
# cost as well as a credential. SEC-10: it belongs in .env.local, which is
# gitignored, and in the host's own environment settings — never in committed
# code, and never pasted into a chat transcript.
# TRY_ON_PROVIDER_API_KEY=
# TRY_ON_PROVIDER_MODEL=gemini-2.5-flash-image

# DEMO PLACEHOLDER, and it applies only while no provider is configured above.
# Enabled (the default), a try-on answers with the garment's own catalogue
# photograph after a short pretend delay, so the whole flow — pick, wait, look —
# can be shown before the external service exists. It is a PLACEHOLDER, not a
# generated image: it shows the model the piece was shot on, not the customer.
# Set it to "disabled" to see §28.5's genuine unavailable state instead. Once
# TRY_ON_PROVIDER_API_KEY is set, this is ignored entirely.
# TRY_ON_SAMPLE_RESULT=enabled
