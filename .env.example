# Server-only (SSOT-03: src/config/env.server.ts)
JAVA_API_BASE_URL=http://localhost:8080
JAVA_API_TIMEOUT_MS=10000

# D1: when "enabled", MSW intercepts outbound calls to JAVA_API_BASE_URL in the
# Next server process. Set to "disabled" once the Java service is reachable.
API_MOCKING=enabled

# Client-safe (SSOT-03: src/config/env.client.ts). SEC-01: treat as published.
NEXT_PUBLIC_APP_URL=http://localhost:3000
