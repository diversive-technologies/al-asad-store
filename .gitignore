# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js build output
.next/
out/
build/
next-env.d.ts

# Testing and caching
coverage/
*.tsbuildinfo
.turbo/
.eslintcache
.vitest/

# Environment — never committed (see .claude/GIT.md §6)
.env
.env.local
.env.*.local

# Personal, machine-local Claude Code settings. The rest of .claude/ is shared
# project configuration and IS committed.
.claude/settings.local.json

# Operator working documents — planning notes, specifications drafted for a
# reader outside the repository, anything written to think with rather than to
# build against. Deliberately NOT history: they go stale the moment the code
# moves, and a stale document in a repository is believed.
#
# The binding documents stay committed: CLAUDE.md, GIT.md, PROGRESS.md and
# docs/system-architecture.md. If something in here becomes binding, move it to
# .claude/docs/ and it is committed again.
.claude/working-docs/

# Editors
.idea/
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Gemini collage sources for the product frames (34MB of intermediates).
# The CROPS they produce are committed under public/products/; these are only
# needed to re-cut them differently. Kept on disk, out of history by size.
/assets/photography/collages/

# The editor's own window, not the project's.
#
# `.vscode/settings.json` here holds `workbench.colorCustomizations` — one
# developer's title bar colour, which every other checkout would be handed and
# none of them wants. It was tracked, so it showed as a modified file in every
# status and diff for the life of the repository.
#
# Ignoring the DIRECTORY is the right call while its only contents are personal.
# If the team later wants shared editor settings — format-on-save, recommended
# extensions — un-ignore those files by name (`!.vscode/extensions.json`) rather
# than dropping this rule, or the personal colours come back with them.
.vscode/

# Vercel CLI project linkage (project id, pulled env). Machine-local.
.vercel
